[Unit]
Description=Per-source connection limits on the gateway ports (nftables table inet inbound_limits)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
After=local-fs.target nftables.service
Conflicts=shutdown.target
ConditionPathExists=/etc/inbound/firewall.nft

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/inbound/firewall.nft
ExecStartPost=/usr/sbin/sysctl -q -p /etc/inbound/conntrack.sysctl
ExecReload=/usr/sbin/nft -f /etc/inbound/firewall.nft
ExecReload=/usr/sbin/sysctl -q -p /etc/inbound/conntrack.sysctl
ExecStop=/usr/sbin/nft delete table inet inbound_limits

[Install]
WantedBy=sysinit.target
