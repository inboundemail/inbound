## Common Patterns

### Pattern 1: List with Pagination

```typescript
import { z } from 'zod'
import { authenticatedProcedure } from '../_lib/procedures'

const ListInput = z.object({
  limit: z.number().int().min(1).max(100).default(50),
  offset: z.number().int().min(0).default(0),
  search: z.string().optional(),
})

const ListOutput = z.object({
  data: z.array(ResourceSchema),
  pagination: z.object({
    limit: z.number(),
    offset: z.number(),
    total: z.number(),
    hasMore: z.boolean(),
  }),
})

export const listResources = authenticatedProcedure
  .route({
    method: 'GET',
    path: '/resources',
    summary: 'List resources',
    tags: ['resources'],
  })
  .input(ListInput)
  .output(ListOutput)
  .handler(async ({ input, context }) => {
    const { limit, offset, search } = input
    const { userId } = context

    // Query with pagination
    const resources = await db.query.resources.findMany({
      where: eq(resources.userId, userId),
      limit,
      offset,
    })

    const total = await db.select({ count: count() })
      .from(resources)
      .where(eq(resources.userId, userId))

    return {
      data: resources,
      pagination: {
        limit,
        offset,
        total: total[0]?.count || 0,
        hasMore: offset + limit < (total[0]?.count || 0),
      },
    }
  })
```

### Pattern 2: Get by ID with Ownership Check

```typescript
export const getResource = authenticatedProcedure
  .route({
    method: 'GET',
    path: '/resources/{id}',
    summary: 'Get resource',
    tags: ['resources'],
  })
  .input(z.object({ id: z.string().uuid() }))
  .output(ResourceSchema)
  .handler(async ({ input, context }) => {
    const resource = await db.query.resources.findFirst({
      where: eq(resources.id, input.id),
    })

    if (!resource) {
      throw new ORPCError('NOT_FOUND', {
        message: 'Resource not found',
      })
    }

    if (resource.userId !== context.userId) {
      throw new ORPCError('FORBIDDEN', {
        message: 'You do not have access to this resource',
      })
    }

    return resource
  })
```

### Pattern 3: Create with Validation

```typescript
export const createResource = authenticatedProcedure
  .route({
    method: 'POST',
    path: '/resources',
    summary: 'Create resource',
    tags: ['resources'],
    successStatus: 201,
  })
  .input(z.object({
    name: z.string().min(1).max(100),
    type: z.enum(['webhook', 'email']),
  }))
  .output(ResourceSchema)
  .handler(async ({ input, context }) => {
    // Check for duplicates
    const existing = await db.query.resources.findFirst({
      where: and(
        eq(resources.userId, context.userId),
        eq(resources.name, input.name)
      ),
    })

    if (existing) {
      throw new ORPCError('CONFLICT', {
        message: 'A resource with this name already exists',
      })
    }

    // Create the resource
    const [resource] = await db
      .insert(resources)
      .values({
        ...input,
        userId: context.userId,
      })
      .returning()

    return resource
  })
```

### Pattern 4: Update (Partial)

```typescript
export const updateResource = authenticatedProcedure
  .route({
    method: 'PATCH',
    path: '/resources/{id}',
    summary: 'Update resource',
    tags: ['resources'],
  })
  .input(z.object({
    id: z.string().uuid(),
    name: z.string().optional(),
    description: z.string().optional(),
    isActive: z.boolean().optional(),
  }))
  .output(ResourceSchema)
  .handler(async ({ input, context }) => {
    const { id, ...updates } = input

    // Verify ownership
    const existing = await db.query.resources.findFirst({
      where: eq(resources.id, id),
    })

    if (!existing) {
      throw new ORPCError('NOT_FOUND', { message: 'Resource not found' })
    }

    if (existing.userId !== context.userId) {
      throw new ORPCError('FORBIDDEN', { message: 'Access denied' })
    }

    // Update
    const [updated] = await db
      .update(resources)
      .set({ ...updates, updatedAt: new Date() })
      .where(eq(resources.id, id))
      .returning()

    return updated
  })
```

### Pattern 5: Delete

```typescript
export const deleteResource = authenticatedProcedure
  .route({
    method: 'DELETE',
    path: '/resources/{id}',
    summary: 'Delete resource',
    tags: ['resources'],
    successStatus: 204,
  })
  .input(z.object({ id: z.string().uuid() }))
  .output(z.object({ success: z.boolean() }))
  .handler(async ({ input, context }) => {
    // Verify ownership
    const existing = await db.query.resources.findFirst({
      where: eq(resources.id, input.id),
    })

    if (!existing) {
      throw new ORPCError('NOT_FOUND', { message: 'Resource not found' })
    }

    if (existing.userId !== context.userId) {
      throw new ORPCError('FORBIDDEN', { message: 'Access denied' })
    }

    // Delete
    await db.delete(resources).where(eq(resources.id, input.id))

    return { success: true }
  })
```

## Middleware Details

### Available Procedures

- **`publicProcedure`**: Logging + Rate Limiting
- **`authenticatedProcedure`**: Logging + Rate Limiting + Authentication

### Context Available in Handlers

**Public Procedure:**
```typescript
{
  headers: Record<string, string | string[] | undefined>
  ip?: string
  userAgent?: string
  rateLimit: {
    limit: number
    remaining: number
    reset: Date
  }
}
```

**Authenticated Procedure (adds):**
```typescript
{
  userId: string
  sessionId: string | undefined
  authMethod: 'session' | 'api-key'
  // ... plus all fields from public procedure
}
```

