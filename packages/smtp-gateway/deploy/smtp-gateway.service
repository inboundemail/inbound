[Unit]
Description=inbound SMTP gateway (smtp.inboundemail.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smtpgw
Group=smtpgw
WorkingDirectory=/opt/inbound/packages/smtp-gateway
EnvironmentFile=/etc/inbound/smtp-gateway.env
ExecStart=/usr/bin/node src/index.ts
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/letsencrypt/live /etc/letsencrypt/archive
PrivateTmp=true
LimitNOFILE=65536
MemoryHigh=600M
MemoryMax=750M
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
