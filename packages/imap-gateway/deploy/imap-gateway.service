[Unit]
Description=inbound IMAP gateway (imap.inboundemail.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=imapgw
Group=imapgw
WorkingDirectory=/opt/inbound/packages/imap-gateway
EnvironmentFile=/etc/inbound/imap-gateway.env
ExecStart=/usr/bin/node src/index.ts
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/letsencrypt/live /etc/letsencrypt/archive
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
