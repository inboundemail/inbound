{
  "name": "inboundemail",
  "version": "1.0.0",
  "description": "The official TypeScript SDK for Inbound",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r44vc0rp/inbound.git",
    "directory": "packages/inbound-sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "generate": "bun run ../../scripts/generate-api.ts"
  },
  "peerDependencies": {
    "@react-email/render": "*"
  },
  "peerDependenciesMeta": {
    "@react-email/render": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-email/render": "^2.0.0",
    "@types/node": "^20.19.0",
    "tsdown": "0.22.3",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
