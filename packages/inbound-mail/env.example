# mock: opens a signed-in local inbox
# auth-mock: previews the complete Sign in with Inbound flow using local data
# live: uses real Inbound OAuth and mail APIs
NEXT_PUBLIC_INBOUND_MAIL_MODE=mock
NEXT_PUBLIC_APP_URL=http://localhost:3010
INBOUND_API_BASE_URL=https://inbound.new
INBOUND_OAUTH_ISSUER=https://inbound.new/api/auth
INBOUND_OAUTH_CLIENT_ID=
INBOUND_OAUTH_CLIENT_SECRET=
INBOUND_MAIL_SESSION_SECRET=replace-with-at-least-32-random-characters
INBOUND_MAIL_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
