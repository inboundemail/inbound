        })
        return NextResponse.json(apiError, { status: 401 })
      }
      
      // pathParams.id is already validated by Zod
      
      // Your existing business logic here
      // Check if resource exists...
      const resourceExists = false // Replace with actual check
      if (!resourceExists) {
        const apiError = buildApiError({
          status: 404,
