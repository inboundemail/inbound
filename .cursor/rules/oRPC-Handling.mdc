    req: {} as any
  }

  beforeEach(async () => {
    // Clean up test data
    await db.delete(emailDomains)
      .where(eq(emailDomains.userId, mockContext.userId))
  })

  it('should create a domain successfully', async () => {
    const result = await createDomain.mutation({
      input: {
        domain: 'test.com',
        isCatchAllEnabled: false
      },
      context: mockContext
    })

    expect(result.domain).toBe('test.com')
    expect(result.userId).toBe(mockContext.userId)
    expect(result.status).toBe('pending')
  })

  it('should throw conflict error for duplicate domain', async () => {
    // Create first domain
    await createDomain.mutation({
      input: { domain: 'test.com', isCatchAllEnabled: false },
      context: mockContext
    })

    // Try to create duplicate
    await expect(
      createDomain.mutation({
        input: { domain: 'test.com', isCatchAllEnabled: false },
        context: mockContext
      })
    ).rejects.toThrow('Domain already exists')
  })
})
```

## Best Practices

### DO:
- ✅ Always use Zod schemas for input/output validation
- ✅ Infer types from database schema where possible
- ✅ Keep each operation in its own file with all related types
- ✅ Use descriptive logging with emojis for consistency
- ✅ Scope all queries by userId for multi-tenancy
- ✅ Handle rate limiting at the procedure level
- ✅ Track errors with Sentry with proper context
- ✅ Export OpenAPI metadata for each procedure
- ✅ Use RESTful path conventions
- ✅ Return proper HTTP status codes

### DON'T:
- ❌ Don't duplicate type definitions across files
- ❌ Don't touch v2 API code
- ❌ Don't use `any` types
- ❌ Don't forget to check user ownership of resources
- ❌ Don't skip input validation
- ❌ Don't expose internal error details to clients
- ❌ Don't bypass rate limiting
- ❌ Don't forget to add OpenAPI documentation

## Error Handling

All procedures should use the unified APIError class:

```typescript
import { APIError, ErrorCodes } from '../types/errors'

// Not found
throw new APIError(ErrorCodes.NOT_FOUND, 'Resource not found', 404)

// Validation error
throw new APIError(
  ErrorCodes.VALIDATION_ERROR,
  'Invalid input',
  400,
  { field: 'email', issue: 'Invalid email format' }
)

// Unauthorized
throw new APIError(ErrorCodes.UNAUTHORIZED, 'Unauthorized', 401)

// Rate limit (handled by middleware)
throw new APIError(
  ErrorCodes.RATE_LIMIT_EXCEEDED,
  'Too many requests',
  429,
  { limit: 5, remaining: 0 }
)
```

## Migration from v2

When creating v3 endpoints:
1. Reference the v2 implementation for business logic
2. Adapt to oRPC procedure pattern
3. Add Zod validation
4. Update types to use shared definitions
5. Add OpenAPI metadata
6. Test thoroughly before deprecating v2

