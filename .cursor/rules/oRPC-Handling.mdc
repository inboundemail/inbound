## File Structure Pattern

Each resource operation should be in its own file following this pattern:

### Create Operation

```typescript
// app/api/v3/domains/create.ts
import { authenticatedProcedure } from '../_lib/procedures'
import { CreateDomainSchema, type DomainResponse } from '../types/domain'
import { APIError, ErrorCodes } from '../types/errors'
import { db } from '@/lib/db'
import { emailDomains } from '@/lib/db/schema'
import { nanoid } from 'nanoid'
import * as Sentry from '@sentry/nextjs'

export const createDomain = authenticatedProcedure
  .input(CreateDomainSchema)
  .output<DomainResponse>()
  .meta({
    openapi: {
      method: 'POST',
      path: '/v3/domains',
      tags: ['Domains'],
      summary: 'Create a new domain',
      description: 'Register a new email domain for receiving emails'
    }
  })
  .mutation(async ({ input, context }) => {
    const span = Sentry.startSpan({ 
      name: 'domain.create',
      attributes: { domain: input.domain }
    })

    try {
      console.log('🌐 Creating domain:', input.domain, 'for user:', context.userId)

      // Check if domain already exists for user
      const existing = await db.query.emailDomains.findFirst({
        where: (domains, { eq, and }) => 
          and(
            eq(domains.domain, input.domain),
            eq(domains.userId, context.userId)
          )
      })

      if (existing) {
        throw new APIError(
          ErrorCodes.CONFLICT,
          'Domain already exists',
          409,
          { domain: input.domain }
        )
      }

      // Create domain
      const [domain] = await db.insert(emailDomains)
        .values({
          id: nanoid(),
          domain: input.domain,
          userId: context.userId,
          status: 'pending',
          canReceiveEmails: false,
          hasMxRecords: false,
          isCatchAllEnabled: input.isCatchAllEnabled,
          catchAllEndpointId: input.catchAllEndpointId,
          createdAt: new Date(),
          updatedAt: new Date()
        })
        .returning()

      console.log('✅ Domain created:', domain.id)

      return {
        ...domain,
        stats: {
          totalEmailAddresses: 0,
          activeEmailAddresses: 0,
          emailsLast24h: 0,
          emailsLast7d: 0,
          emailsLast30d: 0
        }
      }
    } catch (error) {
      if (error instanceof APIError) throw error
      
      console.error('❌ Error creating domain:', error)
      Sentry.captureException(error)
      
      throw new APIError(
        ErrorCodes.INTERNAL_ERROR,
        'Failed to create domain',
        500
      )
    } finally {
      span.end()
    }
  })
```

### Get Operation

```typescript
// app/api/v3/domains/get.ts
import { authenticatedProcedure } from '../_lib/procedures'
import { GetDomainSchema, type DomainResponse } from '../types/domain'
import { APIError, ErrorCodes } from '../types/errors'
import { db } from '@/lib/db'
import { emailDomains, emailAddresses, endpoints } from '@/lib/db/schema'
import { eq, and, count } from 'drizzle-orm'

export const getDomain = authenticatedProcedure
  .input(GetDomainSchema)
  .output<DomainResponse>()
  .meta({
    openapi: {
      method: 'GET',
      path: '/v3/domains/{id}',
      tags: ['Domains'],
      summary: 'Get domain details',
      description: 'Retrieve detailed information about a specific domain'
    }
  })
  .query(async ({ input, context }) => {
    console.log('🔍 Getting domain:', input.id, 'for user:', context.userId)

    // Get domain with user verification
    const domain = await db.query.emailDomains.findFirst({
      where: and(
        eq(emailDomains.id, input.id),
        eq(emailDomains.userId, context.userId)
      )
    })

    if (!domain) {
      throw new APIError(
        ErrorCodes.NOT_FOUND,
        'Domain not found',
        404
      )
    }

    // Get domain statistics
    const [emailCountResult] = await db
      .select({ count: count() })
      .from(emailAddresses)
      .where(eq(emailAddresses.domainId, input.id))

    const [activeEmailCountResult] = await db
      .select({ count: count() })
      .from(emailAddresses)
      .where(and(
        eq(emailAddresses.domainId, input.id),
        eq(emailAddresses.isActive, true)
      ))

    // Get catch-all endpoint if exists
    let catchAllEndpoint = null
    if (domain.catchAllEndpointId) {
      catchAllEndpoint = await db.query.endpoints.findFirst({
        where: eq(endpoints.id, domain.catchAllEndpointId),
        columns: { id: true, name: true, type: true, isActive: true }
      })
    }

    const response: DomainResponse = {
      ...domain,
      stats: {
        totalEmailAddresses: emailCountResult?.count || 0,
        activeEmailAddresses: activeEmailCountResult?.count || 0,
        emailsLast24h: 0, // TODO: Implement
        emailsLast7d: 0,
        emailsLast30d: 0
      },
      catchAllEndpoint
    }

    // Optionally perform verification check
    if (input.check) {
      // TODO: Add DNS and SES verification logic
      response.verificationCheck = {
        isFullyVerified: false
      }
    }

    console.log('✅ Domain retrieved:', domain.domain)
    return response
  })
```

### List Operation

```typescript
// app/api/v3/domains/list.ts
import { authenticatedProcedure } from '../_lib/procedures'
import { ListDomainsSchema, type Domain } from '../types/domain'
import { type PaginatedResponse } from '../types/common'
import { db } from '@/lib/db'
import { emailDomains } from '@/lib/db/schema'
import { eq, desc, count, and } from 'drizzle-orm'

export const listDomains = authenticatedProcedure
  .input(ListDomainsSchema)
  .output<PaginatedResponse<Domain>>()
  .meta({
    openapi: {
      method: 'GET',
      path: '/v3/domains',
      tags: ['Domains'],
      summary: 'List domains',
      description: 'Get a paginated list of domains'
    }
  })
  .query(async ({ input, context }) => {
    console.log('📋 Listing domains for user:', context.userId)

    // Build where conditions
    const conditions = [eq(emailDomains.userId, context.userId)]
    if (input.status) {
      conditions.push(eq(emailDomains.status, input.status))
    }

    // Get domains
    const domains = await db.query.emailDomains.findMany({
      where: and(...conditions),
      orderBy: desc(emailDomains.createdAt),
      limit: input.limit,
      offset: input.offset
    })

    // Get total count
    const [totalResult] = await db
      .select({ count: count() })
      .from(emailDomains)
      .where(and(...conditions))

    const total = totalResult?.count || 0

    return {
      data: domains,
      pagination: {
        limit: input.limit,
        offset: input.offset,
        total,
        hasMore: input.offset + input.limit < total
      }
    }
  })
```

### Update Operation

```typescript
// app/api/v3/domains/update.ts
import { authenticatedProcedure } from '../_lib/procedures'
import { UpdateDomainSchema, type DomainResponse } from '../types/domain'
import { APIError, ErrorCodes } from '../types/errors'
import { db } from '@/lib/db'
import { emailDomains } from '@/lib/db/schema'
import { eq, and } from 'drizzle-orm'
import { z } from 'zod'

const UpdateDomainInputSchema = z.object({
  id: z.string().uuid(),
  data: UpdateDomainSchema
})

export const updateDomain = authenticatedProcedure
  .input(UpdateDomainInputSchema)
  .output<DomainResponse>()
  .meta({
    openapi: {
      method: 'PUT',
      path: '/v3/domains/{id}',
      tags: ['Domains'],
      summary: 'Update domain',
      description: 'Update domain configuration'
    }
  })
  .mutation(async ({ input, context }) => {
    console.log('✏️ Updating domain:', input.id)

    // Verify domain ownership
    const existing = await db.query.emailDomains.findFirst({
      where: and(
        eq(emailDomains.id, input.id),
        eq(emailDomains.userId, context.userId)
      )
    })

    if (!existing) {
      throw new APIError(
        ErrorCodes.NOT_FOUND,
        'Domain not found',
        404
      )
    }

    // Update domain
    const [updated] = await db
      .update(emailDomains)
      .set({
        ...input.data,
        updatedAt: new Date()
      })
      .where(eq(emailDomains.id, input.id))
      .returning()

    console.log('✅ Domain updated:', updated.id)

    return {
      ...updated,
      stats: {
        totalEmailAddresses: 0,
        activeEmailAddresses: 0,
        emailsLast24h: 0,
        emailsLast7d: 0,
        emailsLast30d: 0
      }
    }
  })
```

### Delete Operation

```typescript
// app/api/v3/domains/delete.ts
import { authenticatedProcedure } from '../_lib/procedures'
import { z } from 'zod'
import { APIError, ErrorCodes } from '../types/errors'
import { db } from '@/lib/db'
import { emailDomains } from '@/lib/db/schema'
import { eq, and } from 'drizzle-orm'

const DeleteDomainSchema = z.object({
  id: z.string().uuid()
})

export const deleteDomain = authenticatedProcedure
  .input(DeleteDomainSchema)
  .output(z.object({ success: z.boolean() }))
  .meta({
    openapi: {
      method: 'DELETE',
      path: '/v3/domains/{id}',
      tags: ['Domains'],
      summary: 'Delete domain',
      description: 'Remove a domain from your account'
    }
  })
  .mutation(async ({ input, context }) => {
    console.log('🗑️ Deleting domain:', input.id)

    // Verify domain ownership
    const existing = await db.query.emailDomains.findFirst({
      where: and(
        eq(emailDomains.id, input.id),
        eq(emailDomains.userId, context.userId)
      )
    })

    if (!existing) {
      throw new APIError(
        ErrorCodes.NOT_FOUND,
        'Domain not found',
        404
      )
    }

    // Delete domain
    await db
      .delete(emailDomains)
      .where(eq(emailDomains.id, input.id))

    console.log('✅ Domain deleted:', input.id)

    return { success: true }
  })
```

