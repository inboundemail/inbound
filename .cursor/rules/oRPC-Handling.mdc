## OpenAPI Setup

```typescript
// app/api/v3/route.ts
import { orpc } from '@orpc/server'
import { openAPIHandler } from '@orpc/openapi'
import { domainsRouter } from './domains'
import { emailsRouter } from './emails'
import { endpointsRouter } from './endpoints'

const appRouter = orpc.router({
  domains: domainsRouter,
  emails: emailsRouter,
  endpoints: endpointsRouter
})

export type AppRouter = typeof appRouter

// OpenAPI spec generation
const openapi = openAPIHandler({
  router: appRouter,
  info: {
    title: 'Inbound Email API v3',
    version: '3.0.0',
    description: 'Type-safe email API with OpenAPI support'
  },
  servers: [
    { url: 'https://inbound.new', description: 'Production' },
    { url: 'https://dev.inbound.new', description: 'Development' }
  ],
  security: [
    { BearerAuth: [] },
    { SessionAuth: [] }
  ],
  components: {
    securitySchemes: {
      BearerAuth: {
        type: 'http',
        scheme: 'bearer',
        bearerFormat: 'API Key'
      },
      SessionAuth: {
        type: 'apiKey',
        in: 'cookie',
        name: 'session'
      }
    }
  }
})

// Export handlers
export const GET = openapi.GET
export const POST = openapi.POST
export const PUT = openapi.PUT
export const DELETE = openapi.DELETE
