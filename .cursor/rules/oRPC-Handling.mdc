# oRPC v3 API Structure and Patterns

This rule defines how to structure and implement the v3 API using oRPC for type-safe RPC with OpenAPI compatibility. It provides maneuverability equivalent to v2 while adding type safety and auto-generated documentation.

## Core Principles

- **Type-safe RPC**: Full end-to-end type safety from client to server
- **OpenAPI compliant**: Auto-generate OpenAPI specs for external consumers
- **RESTful routing**: Standard REST conventions (POST /v3/domains, GET /v3/domains/:id)
- **Unified auth**: Both session and API key auth resolve to better-auth user
- **Rate limited**: 5 RPS via Upstash across all endpoints
- **Modular structure**: Each operation in its own file with types and logic
- **Sentry integration**: Error tracking and performance monitoring

## Directory Structure

```
app/api/v3/
├── _lib/
│   ├── context.ts           # Auth context types and builders
│   ├── middleware.ts        # Shared middleware (auth, rate limit, logging)
│   ├── procedures.ts        # Base procedure builders
│   ├── error-handler.ts     # Unified error handling
│   └── rate-limiter.ts      # Upstash rate limiting
├── types/
│   ├── domain.ts            # Domain-related types
│   ├── email.ts             # Email-related types
│   ├── endpoint.ts          # Endpoint-related types
│   ├── common.ts            # Shared types (pagination, etc.)
│   └── errors.ts            # Error response types
└── domains/
│   ├── create.ts            # POST /v3/domains
│   ├── get.ts               # GET /v3/domains/:id
│   ├── update.ts            # PUT /v3/domains/:id
│   ├── delete.ts            # DELETE /v3/domains/:id
│   ├── list.ts              # GET /v3/domains
│   └── index.ts             # Router aggregation
├── everything-else/
```

## Authentication Context

### Context Type Definition

```typescript
// app/api/v3/_lib/context.ts
import { auth } from "@/lib/auth/auth"
import { headers } from "next/headers"
import type { NextRequest } from "next/server"

export interface BaseContext {
  req: NextRequest
}

export interface AuthenticatedContext extends BaseContext {
  userId: string
  authMethod: 'session' | 'api_key'
  user: {
    id: string
    email: string
    name: string
  }
}

export async function createContext(req: NextRequest): Promise<BaseContext> {
  return { req }
}

export async function createAuthenticatedContext(
  req: NextRequest
): Promise<AuthenticatedContext | { error: string }> {
  try {
    // Check session auth
    const session = await auth.api.getSession({
      headers: await headers()
    })

    if (session?.user?.id) {
      return {
        req,
        userId: session.user.id,
        authMethod: 'session',
        user: {
          id: session.user.id,
          email: session.user.email,
          name: session.user.name
        }
      }
    }

    // Check API key auth
    const apiKey = req.headers.get('Authorization')?.replace('Bearer ', '')
    if (!apiKey) {
      return { error: 'No authentication credentials provided' }
    }

    const apiSession = await auth.api.verifyApiKey({
      body: { key: apiKey }
    })

    if (apiSession?.key?.userId) {
      // Fetch user details for API key auth
      const user = await db.query.user.findFirst({
        where: eq(schema.user.id, apiSession.key.userId)
      })

      if (!user) {
        return { error: 'User not found for API key' }
      }

      return {
        req,
        userId: user.id,
        authMethod: 'api_key',
        user: {
          id: user.id,
          email: user.email,
          name: user.name
        }
      }
    }

    return { error: 'Invalid authentication credentials' }
  } catch (error) {
    console.error('❌ Auth context error:', error)
    return { error: 'Authentication failed' }
  }
}
```

## Middleware

### Rate Limiting Middleware

```typescript
// app/api/v3/_lib/rate-limiter.ts
import { Ratelimit } from "@upstash/ratelimit"
import { Redis } from "@upstash/redis"

const redis = new Redis({
  url: process.env.UPSTASH_REDIS_REST_URL!,
  token: process.env.UPSTASH_REDIS_REST_TOKEN!
})

// 5 requests per second per user
export const ratelimit = new Ratelimit({
  redis,
  limiter: Ratelimit.slidingWindow(5, "1s"),
  analytics: true,
  prefix: "ratelimit:v3"
})

export async function checkRateLimit(userId: string) {
  const { success, limit, remaining, reset } = await ratelimit.limit(userId)
  
  if (!success) {
    throw new Error(
      JSON.stringify({
        code: 'RATE_LIMIT_EXCEEDED',
        message: 'Too many requests',
        limit,
        remaining,
        reset
      })
    )
  }

  return { limit, remaining, reset }
}
```

### Auth Middleware

```typescript
// app/api/v3/_lib/middleware.ts
import { createAuthenticatedContext } from './context'
import { checkRateLimit } from './rate-limiter'
import * as Sentry from '@sentry/nextjs'

export async function withAuth(handler: (ctx: AuthenticatedContext) => Promise<any>) {
  return async (req: NextRequest) => {
    const span = Sentry.startSpan({ name: 'v3.api.request' })
    
    try {
      // Create authenticated context
      const ctx = await createAuthenticatedContext(req)
      
      if ('error' in ctx) {
        return Response.json(
          { error: ctx.error },
          { status: 401 }
        )
      }

      // Check rate limit
      const rateLimitInfo = await checkRateLimit(ctx.userId)
      
      // Add rate limit headers
      const response = await handler(ctx)
      
      if (response instanceof Response) {
        response.headers.set('X-RateLimit-Limit', rateLimitInfo.limit.toString())
        response.headers.set('X-RateLimit-Remaining', rateLimitInfo.remaining.toString())
        response.headers.set('X-RateLimit-Reset', rateLimitInfo.reset.toString())
      }

      return response
    } catch (error) {
      Sentry.captureException(error)
      
      if (error instanceof Error && error.message.startsWith('{')) {
        const parsed = JSON.parse(error.message)
        if (parsed.code === 'RATE_LIMIT_EXCEEDED') {
          return Response.json(
            { error: parsed },
            { 
              status: 429,
              headers: {
                'X-RateLimit-Limit': parsed.limit.toString(),
                'X-RateLimit-Remaining': parsed.remaining.toString(),
                'X-RateLimit-Reset': parsed.reset.toString(),
                'Retry-After': Math.ceil((parsed.reset - Date.now()) / 1000).toString()
              }
            }
          )
        }
      }

      return Response.json(
        { error: 'Internal server error' },
        { status: 500 }
      )
    } finally {
      span.end()
    }
  }
}
```

## Procedure Builders

```typescript
// app/api/v3/_lib/procedures.ts
import { orpc } from '@orpc/server'
import { z } from 'zod'
import { createContext, createAuthenticatedContext, type AuthenticatedContext } from './context'
import { checkRateLimit } from './rate-limiter'
import * as Sentry from '@sentry/nextjs'

// Base procedure (no auth required)
export const baseProcedure = orpc
  .context<BaseContext>()
  .use(async (input, context, next) => {
    const span = Sentry.startSpan({ name: 'orpc.base' })
    try {
      return await next(input, context)
    } finally {
      span.end()
    }
  })

// Authenticated procedure (requires auth)
export const authenticatedProcedure = orpc
  .context<AuthenticatedContext>()
  .use(async (input, context, next) => {
    const span = Sentry.startSpan({ 
      name: 'orpc.authenticated',
      attributes: { userId: context.userId }
    })
    
    try {
      // Rate limiting
      const rateLimitInfo = await checkRateLimit(context.userId)
      
      // Continue with request
      const result = await next(input, context)
      
      // Attach rate limit info to response
      return {
        ...result,
        _rateLimit: rateLimitInfo
      }
    } catch (error) {
      Sentry.captureException(error, {
        user: { id: context.userId },
        tags: { authMethod: context.authMethod }
      })
      throw error
    } finally {
      span.end()
    }
  })
```

## Type Definitions

### Common Types

```typescript
// app/api/v3/types/common.ts
import { z } from 'zod'

// Pagination
export const PaginationSchema = z.object({
  limit: z.number().min(1).max(100).default(50),
  offset: z.number().min(0).default(0)
})

export type Pagination = z.infer<typeof PaginationSchema>

export interface PaginatedResponse<T> {
  data: T[]
  pagination: {
    limit: number
    offset: number
    total: number
    hasMore: boolean
  }
}

// Standard success response
export interface SuccessResponse<T> {
  data: T
  meta?: Record<string, any>
}
```

### Error Types

```typescript
// app/api/v3/types/errors.ts
import { z } from 'zod'

export const ErrorResponseSchema = z.object({
  error: z.object({
    code: z.string(),
    message: z.string(),
    details: z.record(z.any()).optional()
  })
})

export type ErrorResponse = z.infer<typeof ErrorResponseSchema>

export class APIError extends Error {
  constructor(
    public code: string,
    message: string,
    public status: number = 400,
    public details?: Record<string, any>
  ) {
    super(message)
    this.name = 'APIError'
  }

  toJSON(): ErrorResponse {
    return {
      error: {
        code: this.code,
        message: this.message,
        details: this.details
      }
    }
  }
}

// Common error codes
export const ErrorCodes = {
  UNAUTHORIZED: 'UNAUTHORIZED',
  FORBIDDEN: 'FORBIDDEN',
  NOT_FOUND: 'NOT_FOUND',
  VALIDATION_ERROR: 'VALIDATION_ERROR',
  RATE_LIMIT_EXCEEDED: 'RATE_LIMIT_EXCEEDED',
  INTERNAL_ERROR: 'INTERNAL_ERROR',
  CONFLICT: 'CONFLICT'
} as const
```

